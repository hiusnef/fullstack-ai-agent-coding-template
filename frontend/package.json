{
  "name": "sample-service-frontend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../contract/api.yaml -o src/lib/api/schema.d.ts",
    "dev": "pnpm gen:api && next dev",
    "build": "pnpm gen:api && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm gen:api && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
